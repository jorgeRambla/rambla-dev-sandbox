{
  "name": "rambla-dev",
  "version": "1.0.0",
  "description": "rambla.dev monorepo (cv + sandbox)",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "turbo run preview",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
